# One Dark Darker, matches ~/.config/sway/config
font=JetBrains Mono 10
background-color=#1f2329
text-color=#a0a8b7
border-color=#4fa6ed
progress-color=over #30363f
border-size=2
border-radius=0
padding=10
margin=10
width=360
default-timeout=6000
icons=1
max-icon-size=48
max-history=50

[urgency=low]
border-color=#535965
default-timeout=3000

[urgency=critical]
border-color=#e55561
default-timeout=0

# toggled with $mod+Ctrl+n; hides popups but keeps them in the history
[mode=do-not-disturb]
invisible=1
