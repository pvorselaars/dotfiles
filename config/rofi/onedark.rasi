/* One Dark Darker, the colours of ~/.config/fuzzel/fuzzel.ini */
* {
    bg:        #1f2329fa;
    fg:        #a0a8b7;
    blue:      #4fa6ed;
    purple:    #bf68d9;
    dim:       #7a818e;
    faint:     #535965;
    selection: #282c34;

    background-color: transparent;
    text-color:       @fg;
    border-color:     @blue;
}

configuration {
    font: "JetBrains Mono 11";
}

window {
    background-color: @bg;
    border:           2px;
    border-radius:    0;
    padding:          12px 20px;
    width:            50ch;
}

mainbox {
    spacing:  8px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing:  8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @blue;
}

entry {
    text-color:        @fg;
    placeholder-color: @faint;
    cursor-color:      @fg;
}

message {
    padding: 0;
    border:  0;
}

textbox {
    text-color: @dim;
}

listview {
    lines:        10;
    scrollbar:    false;
    fixed-height: false;
    spacing:      0;
}

element {
    padding: 3px 8px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @selection;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold #bf68d9;
}
